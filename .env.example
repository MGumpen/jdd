# Kopier til .env:  cp .env.example .env

# Database (brukes av API-et og testene)
POSTGRES_USER=jdd
POSTGRES_PASSWORD=jdd
POSTGRES_DB=jdd
DATABASE_URL=postgresql+psycopg://jdd:jdd@db:5432/jdd

# Test-innboksen
MAILPIT_URL=http://mailpit:8025

# Valgfri. Tom = regelbasert modus. Satt = KI brukes til uttrekk og ekstra anonymisering.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Hvor ofte workeren sjekker innboksen (sekunder)
POLL_INTERVAL_SECONDS=10

# Likhet (0–1) som må nås for at et forslag regnes som oppdatering av en eksisterende artikkel
DUPLICATE_THRESHOLD=0.4
